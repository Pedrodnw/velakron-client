NEXT_PUBLIC_API_URL=http://localhost:5002
# Optional development-only same-origin proxy for a remote API. Set
# NEXT_PUBLIC_API_URL=/velakron-development-api when this is configured.
VELAKRON_DEV_API_PROXY_TARGET=https://staging-api.example.com
NEXT_PUBLIC_VELAKRON_ENABLE_DEV_REGISTRATION=false
NEXT_PUBLIC_SALES_DEMO_URL=https://velakron.com/sales-demo
NEXT_PUBLIC_IMTS_DEMO_URL=https://velakron.com/imts-demo
NEXT_PUBLIC_VELAKRON_INSPECTION_ENABLED=true
